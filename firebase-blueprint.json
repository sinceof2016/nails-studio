{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Cita de servicio en el salón de belleza y spa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "servicePrice": { "type": "number" },
        "serviceDuration": { "type": "number" },
        "serviceImage": { "type": "string" },
        "specialistId": { "type": "string" },
        "specialistName": { "type": "string" },
        "specialistRole": { "type": "string" },
        "specialistAvatar": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "notes": { "type": "string" },
        "polishColor": { "type": "string" },
        "nailShape": { "type": "string" },
        "selectedAddOns": { "type": "array" },
        "totalPrice": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "tipAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmada", "en_preparacion", "completada", "cancelada"] },
        "bookingCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "syncedToGoogleCalendar": { "type": "boolean" },
        "branchId": { "type": "string" }
      },
      "required": ["serviceName", "clientName", "clientPhone", "totalPrice", "status", "bookingCode"]
    },
    "SalonCutRecord": {
      "title": "SalonCutRecord",
      "description": "Registro contable de servicio o corte finalizado en caja.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "hora": { "type": "string" },
        "clienteNombre": { "type": "string" },
        "clienteTelefono": { "type": "string" },
        "servicioNombre": { "type": "string" },
        "servicioPrecio": { "type": "number" },
        "especialistaId": { "type": "string" },
        "especialistaNombre": { "type": "string" },
        "comisionPorcentaje": { "type": "number" },
        "comisionEspecialista": { "type": "number" },
        "recaudoSalon": { "type": "number" },
        "propina": { "type": "number" },
        "metodoPago": { "type": "string" },
        "sucursalId": { "type": "string" },
        "nota": { "type": "string" }
      },
      "required": ["fecha", "clienteNombre", "servicioNombre", "servicioPrecio", "especialistaNombre", "metodoPago"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Registro de gasto o egreso operativo de caja.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "concepto": { "type": "string" },
        "categoria": { "type": "string" },
        "monto": { "type": "number" },
        "sucursalId": { "type": "string" },
        "registradoPor": { "type": "string" }
      },
      "required": ["fecha", "concepto", "monto"]
    },
    "CashRegisterClose": {
      "title": "CashRegisterClose",
      "description": "Comprobante oficial de arqueo y cierre diario de caja.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "hora": { "type": "string" },
        "baseInicial": { "type": "number" },
        "entradasEfectivo": { "type": "number" },
        "entradasDigitales": { "type": "number" },
        "egresosGastos": { "type": "number" },
        "efectivoEsperado": { "type": "number" },
        "efectivoContado": { "type": "number" },
        "diferencia": { "type": "number" },
        "estado": { "type": "string" },
        "responsableNombre": { "type": "string" },
        "sucursalId": { "type": "string" }
      },
      "required": ["fecha", "baseInicial", "entradasEfectivo", "efectivoEsperado", "efectivoContado", "estado"]
    },
    "Service": {
      "title": "Service",
      "description": "Servicio de la carta del salón sincronizado en la nube.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "tag": { "type": "string" },
        "tagType": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "steps": { "type": "array" }
      },
      "required": ["id", "name", "category", "price", "durationMinutes"]
    },
    "Specialist": {
      "title": "Specialist",
      "description": "Perfil de manicurista / especialista del santuario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "availableDays": { "type": "array" },
        "specialties": { "type": "array" },
        "commissionRate": { "type": "number" }
      },
      "required": ["id", "name", "role", "avatar", "availableDays"]
    },
    "ServiceCategory": {
      "title": "ServiceCategory",
      "description": "Categoría o tipo de servicio en la carta.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "label"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Colección global de citas y reservas del salón."
    },
    "/salon_cuts/{cutId}": {
      "schema": "SalonCutRecord",
      "description": "Libro de cortes y servicios realizados para liquidación de caja."
    },
    "/expenses/{expenseId}": {
      "schema": "ExpenseRecord",
      "description": "Gastos y egresos de caja menor."
    },
    "/cash_closes/{closeId}": {
      "schema": "CashRegisterClose",
      "description": "Historial de arqueos y cierres de caja por fecha."
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Carta de servicios sincronizada en vivo."
    },
    "/specialists/{specialistId}": {
      "schema": "Specialist",
      "description": "Equipo de manicuristas sincronizado en vivo."
    },
    "/service_categories/{categoryId}": {
      "schema": "ServiceCategory",
      "description": "Categorías de la carta sincronizadas en vivo."
    }
  }
}
