rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE AUTENTICACIÓN Y ROLES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Comprueba existencia de perfil y rol de staff ('SuperAdmin', 'Administrador' o 'Caja')
    function esStaff() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol in ['SuperAdmin', 'Administrador', 'Caja'];
    }

    // Comprueba existencia de perfil y rol de administración ('SuperAdmin' o 'Administrador')
    function esAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol in ['SuperAdmin', 'Administrador'];
    }

    // Comprueba existencia de perfil y rol SuperAdmin (único que gestiona usuarios)
    function esSuperAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol == 'SuperAdmin';
    }

    // Control de acceso estricto por sede: Administradores tienen acceso global,
    // el personal de caja solo accede a su sede asignada.
    function canAccessBranch(branchId) {
      return esAdmin() || (
        esStaff() &&
        branchId != null &&
        (getUserData().sucursalAsignada == branchId || getUserData().sucursalAsignada == 'todas')
      );
    }

    // =========================================================================
    // AYUDAS DE TIPO Y TAMAÑO (campos opcionales: si existen, deben cumplir el tope)
    // =========================================================================

    function strMax(data, campo, max) {
      return !(campo in data) || (data[campo] is string && data[campo].size() <= max);
    }

    function numMax(data, campo, max) {
      return !(campo in data) || (data[campo] is number && data[campo] >= 0 && data[campo] <= max);
    }

    function boolOpt(data, campo) {
      return !(campo in data) || data[campo] is bool;
    }

    function listMax(data, campo, max) {
      return !(campo in data) || (data[campo] is list && data[campo].size() <= max);
    }

    // Id del bloqueo de horario que le corresponde a una cita (mismo formato que usa la app)
    function lockIdDeCita(data) {
      return data.date + '_' + data.specialistId + '_' + data.time.replace(':', '-').replace(' ', '-');
    }

    // =========================================================================
    // VALIDACIONES ESTRICTAS DE ESQUEMA, TIPOS Y RANGOS
    // =========================================================================

    // Campos y topes comunes de una cita (creación y actualización)
    function isValidAppointmentFields(data) {
      return data.keys().hasOnly([
        'id', 'serviceId', 'serviceName', 'servicePrice', 'serviceDuration',
        'serviceImage', 'specialistId', 'specialistName', 'specialistRole',
        'specialistAvatar', 'date', 'time', 'clientName', 'clientPhone',
        'clientEmail', 'notes', 'polishColor', 'nailShape', 'selectedAddOns',
        'totalPrice', 'paymentMethod', 'montoEfectivo', 'montoDigital',
        'digitalMethod', 'tipAmount', 'status', 'bookingCode', 'createdAt',
        'notifiedViaWhatsApp', 'branchId', 'isGroupBooking', 'groupGuestsCount',
        'autorizacionDatos', 'autorizacionFecha', 'autorizacionVersion'
      ]) &&
      data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
      data.clientPhone is string && data.clientPhone.size() >= 7 && data.clientPhone.size() <= 25 &&
      data.serviceName is string && data.serviceName.size() <= 150 &&
      data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 50000000 &&
      data.bookingCode is string && data.bookingCode.size() <= 30 &&
      strMax(data, 'id', 60) &&
      strMax(data, 'serviceId', 60) &&
      strMax(data, 'specialistId', 60) &&
      strMax(data, 'specialistName', 80) &&
      strMax(data, 'specialistRole', 80) &&
      strMax(data, 'serviceImage', 150000) &&
      strMax(data, 'specialistAvatar', 150000) &&
      strMax(data, 'date', 20) &&
      strMax(data, 'time', 20) &&
      strMax(data, 'clientEmail', 120) &&
      strMax(data, 'notes', 600) &&
      strMax(data, 'polishColor', 100) &&
      strMax(data, 'nailShape', 100) &&
      strMax(data, 'paymentMethod', 30) &&
      strMax(data, 'digitalMethod', 40) &&
      strMax(data, 'createdAt', 40) &&
      strMax(data, 'branchId', 60) &&
      strMax(data, 'autorizacionFecha', 40) &&
      strMax(data, 'autorizacionVersion', 40) &&
      numMax(data, 'servicePrice', 50000000) &&
      numMax(data, 'serviceDuration', 1000) &&
      numMax(data, 'montoEfectivo', 50000000) &&
      numMax(data, 'montoDigital', 50000000) &&
      numMax(data, 'tipAmount', 50000000) &&
      numMax(data, 'groupGuestsCount', 50) &&
      listMax(data, 'selectedAddOns', 20) &&
      boolOpt(data, 'notifiedViaWhatsApp') &&
      boolOpt(data, 'isGroupBooking') &&
      boolOpt(data, 'autorizacionDatos');
    }

    // Validación estricta para creación de cita (pública o por staff)
    // El visitante solo puede crear una cita si en la MISMA operación se crea su bloqueo de horario.
    // El bloqueo debe ser el que nace con esa misma cita (su appointmentId coincide), no uno ya existente de otra cita.
    function isValidNewAppointment(data, aptId) {
      return isValidAppointmentFields(data) &&
      data.date is string && data.time is string && data.specialistId is string &&
      (esStaff() || data.get('autorizacionDatos', false) == true) &&
      data.status in ['confirmada', 'en_preparacion'] &&
      (esStaff() || (
        existsAfter(/databases/$(database)/documents/slot_locks/$(lockIdDeCita(data))) &&
        getAfter(/databases/$(database)/documents/slot_locks/$(lockIdDeCita(data))).data.appointmentId == aptId
      ));
    }

    // Validación estricta para actualización de cita (solo staff)
    function isValidAppointmentUpdate(data) {
      return isValidAppointmentFields(data) &&
      data.status in ['confirmada', 'en_preparacion', 'completada', 'cancelada'];
    }

    // Validación para registros de cobros / cortes de salón (exige sucursalId obligatorio).
    // Si el cobro viene de una cita, su id debe ser 'cut-' + id de la cita: así una cita solo puede cobrarse una vez.
    function isValidCut(data, cutId) {
      return data.keys().hasOnly([
        'id', 'fecha', 'hora', 'clienteNombre', 'clienteTelefono',
        'servicioNombre', 'servicioPrecio', 'especialistaId', 'especialistaNombre',
        'comisionPorcentaje', 'comisionEspecialista', 'recaudoSalon', 'propina',
        'metodoPago', 'montoEfectivo', 'montoDigital', 'digitalMethod',
        'sucursalId', 'nota', 'appointmentId'
      ]) &&
      data.clienteNombre is string && data.clienteNombre.size() > 0 && data.clienteNombre.size() <= 100 &&
      data.servicioNombre is string && data.servicioNombre.size() <= 150 &&
      data.servicioPrecio is number && data.servicioPrecio >= 0 && data.servicioPrecio <= 50000000 &&
      data.comisionEspecialista is number && data.comisionEspecialista >= 0 && data.comisionEspecialista <= 50000000 &&
      data.recaudoSalon is number && data.recaudoSalon >= 0 && data.recaudoSalon <= 50000000 &&
      data.propina is number && data.propina >= 0 && data.propina <= 50000000 &&
      data.sucursalId is string && data.sucursalId.size() > 0 && data.sucursalId.size() <= 60 &&
      data.metodoPago in ['efectivo', 'nequi_daviplata', 'tarjeta_datafono', 'mixto'] &&
      (!('comisionPorcentaje' in data) || (data.comisionPorcentaje is number && data.comisionPorcentaje >= 0 && data.comisionPorcentaje <= 100)) &&
      strMax(data, 'id', 60) &&
      strMax(data, 'fecha', 20) &&
      strMax(data, 'hora', 20) &&
      strMax(data, 'clienteTelefono', 25) &&
      strMax(data, 'especialistaId', 60) &&
      strMax(data, 'especialistaNombre', 80) &&
      strMax(data, 'digitalMethod', 40) &&
      strMax(data, 'nota', 500) &&
      strMax(data, 'appointmentId', 60) &&
      (!('appointmentId' in data) || cutId == 'cut-' + data.appointmentId) &&
      numMax(data, 'montoEfectivo', 50000000) &&
      numMax(data, 'montoDigital', 50000000);
    }

    // Validación para egresos de caja menor (exige sucursalId obligatorio)
    function isValidExpense(data) {
      return data.keys().hasOnly([
        'id', 'fecha', 'concepto', 'categoria', 'monto', 'sucursalId', 'registradoPor'
      ]) &&
      data.concepto is string && data.concepto.size() > 0 && data.concepto.size() <= 200 &&
      data.categoria in ['insumos', 'servicios', 'mantenimiento', 'caja_menor'] &&
      data.sucursalId is string && data.sucursalId.size() > 0 && data.sucursalId.size() <= 60 &&
      data.monto is number && data.monto > 0 && data.monto <= 50000000 &&
      strMax(data, 'id', 60) &&
      strMax(data, 'fecha', 20) &&
      strMax(data, 'registradoPor', 100);
    }

    // Validación para arqueos y cierres de caja (exige sucursalId obligatorio)
    function isValidCashClose(data) {
      return data.keys().hasOnly([
        'id', 'fecha', 'hora', 'baseInicial', 'entradasEfectivo',
        'entradasDigitales', 'egresosGastos', 'efectivoEsperado',
        'efectivoContado', 'diferencia', 'estado', 'responsableNombre', 'sucursalId'
      ]) &&
      data.fecha is string && data.fecha.size() <= 20 &&
      data.sucursalId is string && data.sucursalId.size() > 0 && data.sucursalId.size() <= 60 &&
      data.baseInicial is number && data.baseInicial >= 0 && data.baseInicial <= 1000000000 &&
      data.entradasEfectivo is number && data.entradasEfectivo >= 0 && data.entradasEfectivo <= 1000000000 &&
      data.entradasDigitales is number && data.entradasDigitales >= 0 && data.entradasDigitales <= 1000000000 &&
      data.egresosGastos is number && data.egresosGastos >= 0 && data.egresosGastos <= 1000000000 &&
      data.efectivoEsperado is number && data.efectivoEsperado >= 0 && data.efectivoEsperado <= 1000000000 &&
      data.efectivoContado is number && data.efectivoContado >= 0 && data.efectivoContado <= 1000000000 &&
      data.diferencia is number && data.diferencia >= -1000000000 && data.diferencia <= 1000000000 &&
      data.estado in ['cuadrada', 'descuadre'] &&
      strMax(data, 'id', 60) &&
      strMax(data, 'hora', 20) &&
      strMax(data, 'responsableNombre', 100);
    }

    // Perfil de usuario del sistema (solo lo escribe el SuperAdmin). Solo 'rol' es obligatorio.
    function isValidUser(data) {
      return data.keys().hasOnly([
        'id', 'nombre', 'email', 'rol', 'sucursalAsignada', 'avatar',
        'creadoEn', 'puedeVerApi', 'puedeVerUsuarios'
      ]) &&
      data.rol in ['SuperAdmin', 'Administrador', 'Caja'] &&
      strMax(data, 'id', 128) &&
      strMax(data, 'nombre', 100) &&
      strMax(data, 'email', 120) &&
      strMax(data, 'sucursalAsignada', 60) &&
      strMax(data, 'avatar', 150000) &&
      strMax(data, 'creadoEn', 40) &&
      boolOpt(data, 'puedeVerApi') &&
      boolOpt(data, 'puedeVerUsuarios');
    }

    // =========================================================================
    // REGLAS POR COLECCIÓN
    // =========================================================================

    // Colección: users (Perfiles y roles de personal)
    // Lee: El propio usuario autenticado o administradores.
    // Crea / Actualiza / Borra: Solo el SuperAdmin.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || esAdmin());
      allow create, update: if esSuperAdmin() && isValidUser(request.resource.data);
      allow delete: if esSuperAdmin();
    }

    // Colección: appointments (Citas y turnos del santuario)
    // Lee: Solo personal verificado (esStaff).
    // Crea: Público/clientes (reserva online con validación estricta, estado inicial y bloqueo de horario en la misma operación).
    // Actualiza: Solo personal verificado (esStaff).
    // Borra: Solo administradores (esAdmin).
    match /appointments/{appointmentId} {
      allow list: if esStaff();
      // El visitante solo puede 'consultar' un ID que todavía no existe (la reserva comprueba que esté libre); nunca lee una cita.
      allow get: if esStaff() || resource == null;
      allow create: if isValidNewAppointment(request.resource.data, appointmentId);
      allow update: if isValidAppointmentUpdate(request.resource.data) && esStaff();
      allow delete: if esAdmin();
    }

    // Colección: slot_locks (Bloqueos de horarios para prevenir doble reserva)
    // Lee: Público (los visitantes consultan horarios ocupados sin acceder a datos personales de clientes).
    // Crea: Público/Staff en transacción junto con la cita (solo si no existe).
    // Actualiza: No permitido (inmutables).
    // Borra: Solo personal verificado (esStaff), al cancelar o reprogramar una cita.
    match /slot_locks/{lockId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/slot_locks/$(lockId)) &&
                       string(lockId).size() <= 120 &&
                       request.resource.data.keys().hasOnly(['appointmentId', 'slot', 'date', 'specialistId', 'createdAt']) &&
                       request.resource.data.appointmentId is string && request.resource.data.appointmentId.size() <= 60 &&
                       request.resource.data.slot is string && request.resource.data.slot.size() <= 20 &&
                       request.resource.data.date is string && request.resource.data.date.size() <= 20 &&
                       request.resource.data.specialistId is string && request.resource.data.specialistId.size() <= 60 &&
                       strMax(request.resource.data, 'createdAt', 40) &&
                       (
                         // (1) Reserva nueva: el bloqueo nace junto con la cita nueva que lo origina (misma transacción)
                         (
                           !exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.slot &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.specialistId == request.resource.data.specialistId
                         ) ||
                         // (2) Reactivar una cita cancelada: solo el personal puede recrear el bloqueo de una cita que ya existe y coincide
                         (
                           esStaff() &&
                           exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.slot &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.specialistId == request.resource.data.specialistId
                         )
                       );
      allow update: if false;
      allow delete: if esStaff();
    }

    // Colección: salon_cuts (Libro de cobros y comisiones)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /salon_cuts/{cutId} {
      // get: un documento que aun no existe se puede consultar (la app lo hace antes de crear un cobro, gasto o cierre).
      allow get: if esStaff() && (resource == null || canAccessBranch(resource.data.sucursalId));
      // list: el personal de caja debe consultar con where('sucursalId', '==', su sede). Administradores pueden listar todo.
      allow list: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidCut(request.resource.data, cutId) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidCut(request.resource.data, cutId) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // Colección: expenses (Gastos y salidas de caja menor)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /expenses/{expenseId} {
      // get: un documento que aun no existe se puede consultar (la app lo hace antes de crear un cobro, gasto o cierre).
      allow get: if esStaff() && (resource == null || canAccessBranch(resource.data.sucursalId));
      // list: el personal de caja debe consultar con where('sucursalId', '==', su sede). Administradores pueden listar todo.
      allow list: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidExpense(request.resource.data) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidExpense(request.resource.data) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // Colección: cash_closes (Arqueos y cierres de caja diarios)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /cash_closes/{closeId} {
      // get: un documento que aun no existe se puede consultar (la app lo hace antes de crear un cobro, gasto o cierre).
      allow get: if esStaff() && (resource == null || canAccessBranch(resource.data.sucursalId));
      // list: el personal de caja debe consultar con where('sucursalId', '==', su sede). Administradores pueden listar todo.
      allow list: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidCashClose(request.resource.data) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidCashClose(request.resource.data) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // =========================================================================
    // CATÁLOGO Y DATOS DEL NEGOCIO (editables solo por el SuperAdmin, visibles para todos)
    // =========================================================================

    // Tipos de servicio. Lee: público. Escribe: solo SuperAdmin.
    function isValidCategory(data, id) {
      return data.keys().hasOnly(['id', 'label', 'icon', 'description']) &&
        data.id == id &&
        data.label is string && data.label.size() > 0 && data.label.size() <= 80 &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 40)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 200));
    }

    // Servicios. Lee: público. Escribe: solo SuperAdmin. La imagen puede ser una URL o una imagen comprimida en base64 (máx. 150.000 caracteres, unos 110 KB).
    function isValidService(data, id) {
      return data.keys().hasOnly([
        'id', 'name', 'category', 'categoryLabel', 'price', 'durationMinutes',
        'rating', 'reviewsCount', 'tag', 'tagType', 'description', 'image',
        'steps', 'recommendedFor'
      ]) &&
        data.id == id &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
        data.categoryLabel is string && data.categoryLabel.size() <= 100 &&
        data.price is number && data.price >= 0 && data.price <= 10000000 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 600 &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        (!('reviewsCount' in data) || (data.reviewsCount is number && data.reviewsCount >= 0)) &&
        (!('tag' in data) || (data.tag is string && data.tag.size() <= 40)) &&
        (!('tagType' in data) || data.tagType in ['top', 'relax', 'trend', 'care']) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('image' in data) || (data.image is string && data.image.size() <= 150000)) &&
        (!('steps' in data) || (data.steps is list && data.steps.size() <= 20)) &&
        (!('recommendedFor' in data) || (data.recommendedFor is string && data.recommendedFor.size() <= 300));
    }

    // Especialistas (parte PÚBLICA: sin teléfono ni comisión). Lee: público. Escribe: solo SuperAdmin.
    function isValidSpecialist(data, id) {
      return data.keys().hasOnly([
        'id', 'name', 'role', 'rating', 'reviewsCount', 'avatar', 'bio',
        'certifications', 'availableDays', 'specialties'
      ]) &&
        data.id == id &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        data.role is string && data.role.size() <= 80 &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        (!('reviewsCount' in data) || (data.reviewsCount is number && data.reviewsCount >= 0)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 150000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 1500)) &&
        (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 20)) &&
        (!('availableDays' in data) || (data.availableDays is list && data.availableDays.size() <= 7)) &&
        (!('specialties' in data) || (data.specialties is list && data.specialties.size() <= 20));
    }

    // Especialistas (parte PRIVADA: teléfono y comisión). Lee: personal. Escribe: solo SuperAdmin.
    function isValidSpecialistPrivate(data) {
      return data.keys().hasOnly(['phone', 'commissionRate']) &&
        data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    // Datos del negocio (documento settings/negocio). Lee: público. Escribe: solo SuperAdmin.
    function isValidNegocio(data) {
      return data.keys().hasOnly([
        'businessName', 'brandName', 'nit', 'representanteLegal', 'address', 'city', 'country',
        'phone', 'phoneFormatted', 'whatsapp', 'whatsappFormatted', 'email', 'privacyEmail',
        'branchName', 'bookingCodePrefix', 'taxNotice', 'cancellationNoticeHours',
        'advancePaymentRequired', 'dataPolicyVersion', 'privacyNoticeVersion', 'termsVersion',
        'cancellationPolicyVersion'
      ]) &&
        data.businessName is string && data.businessName.size() <= 200 &&
        data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 100 &&
        (!('nit' in data) || (data.nit is string && data.nit.size() <= 40)) &&
        (!('representanteLegal' in data) || (data.representanteLegal is string && data.representanteLegal.size() <= 120)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('phoneFormatted' in data) || (data.phoneFormatted is string && data.phoneFormatted.size() <= 40)) &&
        (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30)) &&
        (!('whatsappFormatted' in data) || (data.whatsappFormatted is string && data.whatsappFormatted.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('privacyEmail' in data) || (data.privacyEmail is string && data.privacyEmail.size() <= 120)) &&
        (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 100)) &&
        (!('bookingCodePrefix' in data) || (data.bookingCodePrefix is string && data.bookingCodePrefix.size() <= 10)) &&
        (!('taxNotice' in data) || (data.taxNotice is string && data.taxNotice.size() <= 300)) &&
        (!('cancellationNoticeHours' in data) || (data.cancellationNoticeHours is number && data.cancellationNoticeHours >= 0 && data.cancellationNoticeHours <= 720)) &&
        (!('advancePaymentRequired' in data) || data.advancePaymentRequired is bool) &&
        (!('dataPolicyVersion' in data) || (data.dataPolicyVersion is string && data.dataPolicyVersion.size() <= 40)) &&
        (!('privacyNoticeVersion' in data) || (data.privacyNoticeVersion is string && data.privacyNoticeVersion.size() <= 40)) &&
        (!('termsVersion' in data) || (data.termsVersion is string && data.termsVersion.size() <= 40)) &&
        (!('cancellationPolicyVersion' in data) || (data.cancellationPolicyVersion is string && data.cancellationPolicyVersion.size() <= 40));
    }

    match /service_categories/{categoryId} {
      allow read: if true;
      allow create, update: if esSuperAdmin() && isValidCategory(request.resource.data, categoryId);
      allow delete: if esSuperAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if esSuperAdmin() && isValidService(request.resource.data, serviceId);
      allow delete: if esSuperAdmin();
    }

    match /specialists/{specialistId} {
      allow read: if true;
      allow create, update: if esSuperAdmin() && isValidSpecialist(request.resource.data, specialistId);
      allow delete: if esSuperAdmin();
    }

    match /specialists_private/{specialistId} {
      allow read: if esStaff();
      allow create, update: if esSuperAdmin() && isValidSpecialistPrivate(request.resource.data);
      allow delete: if esSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'negocio';
      allow create, update: if settingId == 'negocio' && esSuperAdmin() && isValidNegocio(request.resource.data);
      allow delete: if false;
    }

    // =========================================================================
    // DENEGACIÓN POR DEFECTO PARA CUALQUIER OTRA RUTA NO MAPEDA
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
