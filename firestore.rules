rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE AUTENTICACIÓN Y ROLES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Comprueba existencia de perfil y rol de staff ('SuperAdmin', 'Administrador' o 'Caja')
    function esStaff() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol in ['SuperAdmin', 'Administrador', 'Caja'];
    }

    // Comprueba existencia de perfil y rol de administración ('SuperAdmin' o 'Administrador')
    function esAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol in ['SuperAdmin', 'Administrador'];
    }

    // Comprueba existencia de perfil y rol SuperAdmin (único que gestiona usuarios)
    function esSuperAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().rol == 'SuperAdmin';
    }

    // Control de acceso estricto por sede: Administradores tienen acceso global,
    // el personal de caja solo accede a su sede asignada.
    function canAccessBranch(branchId) {
      return esAdmin() || (
        esStaff() &&
        branchId != null &&
        (getUserData().sucursalAsignada == branchId || getUserData().sucursalAsignada == 'todas')
      );
    }

    // =========================================================================
    // VALIDACIONES ESTRICTAS DE ESQUEMA, TIPOS Y RANGOS
    // =========================================================================

    // Validación estricta para creación de cita (pública o por staff)
    function isValidNewAppointment(data) {
      return data.keys().hasOnly([
        'id', 'serviceId', 'serviceName', 'servicePrice', 'serviceDuration',
        'serviceImage', 'specialistId', 'specialistName', 'specialistRole',
        'specialistAvatar', 'date', 'time', 'clientName', 'clientPhone',
        'clientEmail', 'notes', 'polishColor', 'nailShape', 'selectedAddOns',
        'totalPrice', 'paymentMethod', 'montoEfectivo', 'montoDigital',
        'digitalMethod', 'tipAmount', 'status', 'bookingCode', 'createdAt',
        'notifiedViaWhatsApp', 'branchId', 'isGroupBooking', 'groupGuestsCount',
        'autorizacionDatos', 'autorizacionFecha', 'autorizacionVersion'
      ]) &&
      data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
      data.clientPhone is string && data.clientPhone.size() >= 7 && data.clientPhone.size() <= 25 &&
      (esStaff() || data.get('autorizacionDatos', false) == true) &&
      data.serviceName is string && data.serviceName.size() <= 150 &&
      data.totalPrice is number && data.totalPrice >= 0 &&
      data.bookingCode is string && data.bookingCode.size() <= 30 &&
      data.status in ['confirmada', 'en_preparacion'] &&
      (!('servicePrice' in data) || (data.servicePrice is number && data.servicePrice >= 0)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Validación estricta para actualización de cita (solo staff)
    function isValidAppointmentUpdate(data) {
      return data.keys().hasOnly([
        'id', 'serviceId', 'serviceName', 'servicePrice', 'serviceDuration',
        'serviceImage', 'specialistId', 'specialistName', 'specialistRole',
        'specialistAvatar', 'date', 'time', 'clientName', 'clientPhone',
        'clientEmail', 'notes', 'polishColor', 'nailShape', 'selectedAddOns',
        'totalPrice', 'paymentMethod', 'montoEfectivo', 'montoDigital',
        'digitalMethod', 'tipAmount', 'status', 'bookingCode', 'createdAt',
        'notifiedViaWhatsApp', 'branchId', 'isGroupBooking', 'groupGuestsCount',
        'autorizacionDatos', 'autorizacionFecha', 'autorizacionVersion'
      ]) &&
      data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
      data.clientPhone is string && data.clientPhone.size() >= 7 && data.clientPhone.size() <= 25 &&
      data.totalPrice is number && data.totalPrice >= 0 &&
      data.status in ['confirmada', 'en_preparacion', 'completada', 'cancelada'] &&
      (!('servicePrice' in data) || (data.servicePrice is number && data.servicePrice >= 0)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Validación para registros de cobros / cortes de salón (exige sucursalId obligatorio)
    function isValidCut(data) {
      return data.keys().hasOnly([
        'id', 'fecha', 'hora', 'clienteNombre', 'clienteTelefono',
        'servicioNombre', 'servicioPrecio', 'especialistaId', 'especialistaNombre',
        'comisionPorcentaje', 'comisionEspecialista', 'recaudoSalon', 'propina',
        'metodoPago', 'montoEfectivo', 'montoDigital', 'digitalMethod',
        'sucursalId', 'nota'
      ]) &&
      data.clienteNombre is string && data.clienteNombre.size() > 0 && data.clienteNombre.size() <= 100 &&
      data.servicioNombre is string && data.servicioNombre.size() <= 150 &&
      data.servicioPrecio is number && data.servicioPrecio >= 0 &&
      data.comisionEspecialista is number && data.comisionEspecialista >= 0 &&
      data.recaudoSalon is number && data.recaudoSalon >= 0 &&
      data.propina is number && data.propina >= 0 &&
      data.sucursalId is string && data.sucursalId.size() > 0 &&
      data.metodoPago in ['efectivo', 'nequi_daviplata', 'tarjeta_datafono', 'mixto'] &&
      (!('comisionPorcentaje' in data) || (data.comisionPorcentaje is number && data.comisionPorcentaje >= 0 && data.comisionPorcentaje <= 100)) &&
      (!('nota' in data) || (data.nota is string && data.nota.size() <= 500));
    }

    // Validación para egresos de caja menor (exige sucursalId obligatorio)
    function isValidExpense(data) {
      return data.keys().hasOnly([
        'id', 'fecha', 'concepto', 'categoria', 'monto', 'sucursalId', 'registradoPor'
      ]) &&
      data.concepto is string && data.concepto.size() > 0 && data.concepto.size() <= 200 &&
      data.categoria in ['insumos', 'servicios', 'mantenimiento', 'caja_menor'] &&
      data.sucursalId is string && data.sucursalId.size() > 0 &&
      data.monto is number && data.monto > 0;
    }

    // Validación para arqueos y cierres de caja (exige sucursalId obligatorio)
    function isValidCashClose(data) {
      return data.keys().hasOnly([
        'id', 'fecha', 'hora', 'baseInicial', 'entradasEfectivo',
        'entradasDigitales', 'egresosGastos', 'efectivoEsperado',
        'efectivoContado', 'diferencia', 'estado', 'responsableNombre', 'sucursalId'
      ]) &&
      data.fecha is string &&
      data.sucursalId is string && data.sucursalId.size() > 0 &&
      data.baseInicial is number && data.baseInicial >= 0 &&
      data.entradasEfectivo is number && data.entradasEfectivo >= 0 &&
      data.entradasDigitales is number && data.entradasDigitales >= 0 &&
      data.egresosGastos is number && data.egresosGastos >= 0 &&
      data.efectivoEsperado is number && data.efectivoEsperado >= 0 &&
      data.efectivoContado is number && data.efectivoContado >= 0 &&
      data.diferencia is number &&
      data.estado in ['cuadrada', 'descuadre'];
    }

    // =========================================================================
    // REGLAS POR COLECCIÓN
    // =========================================================================

    // Colección: users (Perfiles y roles de personal)
    // Lee: El propio usuario autenticado o administradores.
    // Crea / Actualiza / Borra: Solo el SuperAdmin.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || esAdmin());
      allow write: if esSuperAdmin();
    }

    // Colección: appointments (Citas y turnos del santuario)
    // Lee: Solo personal verificado (esStaff).
    // Crea: Público/clientes (reserva online con validación estricta y estado inicial).
    // Actualiza: Solo personal verificado (esStaff).
    // Borra: Solo administradores (esAdmin).
    match /appointments/{appointmentId} {
      allow list: if esStaff();
      // El visitante solo puede 'consultar' un ID que todavía no existe (la reserva comprueba que esté libre); nunca lee una cita.
      allow get: if esStaff() || resource == null;
      allow create: if isValidNewAppointment(request.resource.data);
      allow update: if isValidAppointmentUpdate(request.resource.data) && esStaff();
      allow delete: if esAdmin();
    }

    // Colección: slot_locks (Bloqueos de horarios para prevenir doble reserva)
    // Lee: Público (los visitantes consultan horarios ocupados sin acceder a datos personales de clientes).
    // Crea: Público/Staff en transacción junto con la cita (solo si no existe).
    // Actualiza: No permitido (inmutables).
    // Borra: Solo personal verificado (esStaff), al cancelar o reprogramar una cita.
    match /slot_locks/{lockId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/slot_locks/$(lockId)) &&
                       request.resource.data.keys().hasOnly(['appointmentId', 'slot', 'date', 'specialistId', 'createdAt']) &&
                       request.resource.data.appointmentId is string &&
                       request.resource.data.slot is string &&
                       request.resource.data.date is string &&
                       request.resource.data.specialistId is string &&
                       (
                         // (1) Reserva nueva: el bloqueo nace junto con la cita nueva que lo origina (misma transacción)
                         (
                           !exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.slot &&
                           getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.specialistId == request.resource.data.specialistId
                         ) ||
                         // (2) Reactivar una cita cancelada: solo el personal puede recrear el bloqueo de una cita que ya existe y coincide
                         (
                           esStaff() &&
                           exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)) &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.slot &&
                           get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.specialistId == request.resource.data.specialistId
                         )
                       );
      allow update: if false;
      allow delete: if esStaff();
    }

    // Colección: salon_cuts (Libro de cobros y comisiones)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /salon_cuts/{cutId} {
      allow read: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidCut(request.resource.data) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidCut(request.resource.data) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // Colección: expenses (Gastos y salidas de caja menor)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /expenses/{expenseId} {
      allow read: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidExpense(request.resource.data) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidExpense(request.resource.data) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // Colección: cash_closes (Arqueos y cierres de caja diarios)
    // Lee: Solo personal verificado de la sede (esStaff y canAccessBranch).
    // Crea: Solo personal verificado de la sede (esStaff y canAccessBranch sobre la sede creada).
    // Actualiza: Solo personal de la sede de origen y destino (canAccessBranch origen Y destino).
    // Borra: Solo administradores (esAdmin).
    match /cash_closes/{closeId} {
      allow read: if esStaff() && canAccessBranch(resource.data.sucursalId);
      allow create: if isValidCashClose(request.resource.data) && esStaff() && canAccessBranch(request.resource.data.sucursalId);
      allow update: if isValidCashClose(request.resource.data) && esStaff() && canAccessBranch(resource.data.sucursalId) && canAccessBranch(request.resource.data.sucursalId);
      allow delete: if esAdmin();
    }

    // =========================================================================
    // DENEGACIÓN POR DEFECTO PARA CUALQUIER OTRA RUTA NO MAPEDA
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
